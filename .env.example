# ============================================================================
# CFR-App: Life Science Asset & GxP Backup Management System
# Copy this file to .env and customize for your deployment
# ============================================================================

# PostgreSQL Database
POSTGRES_USER=cfr_admin
POSTGRES_PASSWORD=cfr_secure_password_change_me
POSTGRES_DB=cfr_asset_backup
DATABASE_URL=postgresql://cfr_admin:cfr_secure_password_change_me@db:5432/cfr_asset_backup

# Security & 21 CFR Part 11 Cryptography
JWT_SECRET_KEY=change-this-to-a-64-char-random-hex-secret-in-production
# Fernet 32-byte URL-safe base64-encoded key (auto-generated if omitted in dev)
MASTER_ENCRYPTION_KEY=

# Built-in Restic REST Server (--append-only mode for ransomware/GMP protection)
RESTIC_REST_SERVER_URL=http://restic-server:8000
RESTIC_REST_EXTERNAL_URL=http://localhost:8000
RESTIC_DEFAULT_REPO_PASSWORD=gmp-restic-repo-default-password

# Built-in MinIO S3-Compatible Object Storage
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_secret_change_me
MINIO_ENDPOINT=http://minio:9000
MINIO_EXTERNAL_CONSOLE=http://localhost:9001

# Public URL of the CFR-App Backend API (used by endpoint backup agents)
PUBLIC_API_URL=http://localhost:8080/api/v1
